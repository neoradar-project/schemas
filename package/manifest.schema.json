{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "centerPoint": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "NOT HONOURED. Parsed and validated as [lon, lat] but never read: the startup viewport comes from the active profile's map/windowArea."
    },
    "mapLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "geojson"
            ]
          },
          "source": {
            "type": "string"
          },
          "zIndex": {
            "type": "number"
          },
          "defaultStyle": {
            "type": "object",
            "properties": {
              "lineStyle": {
                "type": "object",
                "properties": {
                  "color": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3,
                        "description": "RGB color array [r,g,b]"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 4,
                        "maxItems": 4,
                        "description": "RGBA color array [r,g,b,a]"
                      }
                    ],
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a)"
                  },
                  "width": {
                    "type": "number",
                    "default": 1
                  },
                  "opacity": {
                    "type": "number",
                    "default": 1
                  },
                  "dashArray": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "Dash array [length, gap]"
                  }
                },
                "required": [
                  "color"
                ],
                "additionalProperties": false
              },
              "fillStyle": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color"
                  },
                  "opacity": {
                    "type": "number",
                    "default": 1
                  }
                },
                "required": [
                  "color"
                ],
                "additionalProperties": false
              },
              "pointStyle": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "sprite",
                      "circle",
                      "square",
                      "diamond",
                      "cross"
                    ],
                    "default": "circle"
                  },
                  "size": {
                    "type": "number",
                    "default": 10,
                    "description": "Size of the point in cartesian units"
                  },
                  "sprite": {
                    "type": "string",
                    "description": "Name of the sprite defined in the sprite atlas"
                  },
                  "fillColor": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a)"
                  },
                  "fillOpacity": {
                    "type": "number",
                    "default": 1
                  },
                  "strokeColor": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a)"
                  },
                  "strokeOpacity": {
                    "type": "number",
                    "default": 1
                  },
                  "strokeWidth": {
                    "type": "number",
                    "default": 1
                  },
                  "rotation": {
                    "type": "number",
                    "default": 0,
                    "description": "Rotation of the symbol in degrees"
                  }
                },
                "additionalProperties": false
              },
              "textStyle": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "color": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a) NOT HONOURED here: a map label takes its point's own colour at full alpha. Set the point colour instead."
                  },
                  "fontFamily": {
                    "type": "string",
                    "default": "RobotoMono-Regular",
                    "description": "NOT HONOURED here: map labels are rasterised in the renderer-wide font family."
                  },
                  "fontSize": {
                    "type": "number",
                    "default": 12
                  },
                  "fontWeight": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "bold",
                      "bolder",
                      "lighter",
                      "100",
                      "200",
                      "300",
                      "400",
                      "500",
                      "600",
                      "700",
                      "800",
                      "900"
                    ],
                    "default": "normal",
                    "description": "NOT HONOURED: the label atlas is rasterised at one weight. Use a bold fontFamily if the renderer gains per-layer families."
                  },
                  "size": {
                    "type": "number",
                    "default": 10,
                    "description": "NOT HONOURED. Use fontSize."
                  },
                  "offset": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      0,
                      0
                    ]
                  },
                  "anchor": {
                    "type": "string",
                    "enum": [
                      "start",
                      "middle",
                      "end"
                    ],
                    "default": "middle",
                    "description": "NOT HONOURED. Labels are positioned by offset alone."
                  },
                  "baseline": {
                    "type": "string",
                    "enum": [
                      "top",
                      "middle",
                      "bottom",
                      "alphabetic"
                    ],
                    "default": "middle",
                    "description": "NOT HONOURED. Labels are positioned by offset alone."
                  },
                  "letterSpacing": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED."
                  },
                  "lineHeight": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED. Map labels are single-line."
                  },
                  "align": {
                    "type": "string",
                    "enum": [
                      "left",
                      "center",
                      "right"
                    ],
                    "default": "center",
                    "description": "NOT HONOURED. Map labels are single-line."
                  },
                  "wordWrap": {
                    "type": "boolean",
                    "default": false,
                    "description": "NOT HONOURED. Map labels are single-line."
                  },
                  "wordWrapWidth": {
                    "type": "number",
                    "default": 100,
                    "description": "NOT HONOURED. Map labels are single-line."
                  },
                  "outlineColor": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a) NOT HONOURED here. Text outlines are supported on routeDraw.textStyle only."
                  },
                  "outlineWidth": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED here. Text outlines are supported on routeDraw.textStyle only."
                  },
                  "outlineOpacity": {
                    "type": "number",
                    "default": 1,
                    "description": "NOT HONOURED here. Text outlines are supported on routeDraw.textStyle only."
                  },
                  "dropShadow": {
                    "type": "boolean",
                    "default": false,
                    "description": "NOT HONOURED."
                  },
                  "dropShadowColor": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a) NOT HONOURED.",
                    "default": [
                      0,
                      0,
                      0
                    ]
                  },
                  "dropShadowAngle": {
                    "type": "number",
                    "default": 0.5235987755982988,
                    "description": "NOT HONOURED."
                  },
                  "dropShadowBlur": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED."
                  },
                  "dropShadowDistance": {
                    "type": "number",
                    "default": 5,
                    "description": "NOT HONOURED."
                  },
                  "dropShadowOpacity": {
                    "type": "number",
                    "default": 1,
                    "description": "NOT HONOURED."
                  },
                  "scaleWithZoom": {
                    "type": "boolean",
                    "default": true,
                    "description": "NOT SUPPORTED. Map labels are a constant screen size by design, and the per-size glyph atlases depend on that; zoom-scaled text would need an SDF path."
                  },
                  "minZoom": {
                    "type": "number",
                    "description": "NOT HONOURED. Zoom gating is per layer, not per text style."
                  },
                  "maxZoom": {
                    "type": "number",
                    "description": "NOT HONOURED. Zoom gating is per layer, not per text style."
                  },
                  "padding": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED."
                  },
                  "backgroundColor": {
                    "$ref": "#/properties/mapLayers/items/properties/defaultStyle/properties/lineStyle/properties/color",
                    "description": "RGBA color array [r,g,b,a] or [r,g,b] (0-255, and 0-1 for a)"
                  },
                  "backgroundOpacity": {
                    "type": "number",
                    "default": 0,
                    "description": "NOT HONOURED: labels have no background plate."
                  }
                },
                "additionalProperties": false
              },
              "geodesic": {
                "type": "boolean",
                "default": true,
                "description": "Whether a long oblique segment is drawn as the great circle between its ends instead of the straight Mercator chord. Default true. Segments under 20 km and segments whose ends share a latitude (a parallel) are always straight. Overridable per feature with a top-level geodesic property. The server projects sector volumes with the same rule."
              }
            },
            "additionalProperties": false
          },
          "hasLabels": {
            "type": "boolean"
          },
          "isLabelLayer": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string"
          },
          "src": {
            "type": "string"
          }
        },
        "required": [
          "alias",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "lastActiveProfile": {
      "type": "string"
    },
    "remoteSource": {
      "type": "object",
      "properties": {
        "providerUrl": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "providerName": {
          "type": "string"
        },
        "downloadedAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "providerUrl",
        "providerName",
        "version"
      ],
      "additionalProperties": false
    },
    "altitudeFormat": {
      "$ref": "#/$defs/altitudeFormat"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Plugins this package loads when it is opened. Each entry is a .dll or a .nrplugin archive, given either as a full path or as a path relative to the package root (e.g. \"plugins/UKControllerPlugin.nrplugin\"). A .nrplugin is referenced as the archive, never as the binary it unpacks. The client's plugin window writes full paths here; a package ships its own plugins as relative ones."
    },
    "ignorePaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "$schema",
    "id",
    "name",
    "version",
    "namespace",
    "createdAt",
    "centerPoint"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "altitudeFormat": {
      "type": "object",
      "additionalProperties": false,
      "description": "How altitude-valued tag items render either side of the transition altitude. A system's labels.json overrides this; omit both and items using \"format\" fall back to the EuroScope convention (an \"A\" and two digits below, three above).",
      "properties": {
        "belowTransition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "description": "Text before the digits, e.g. \"A\" below the transition altitude."
            },
            "suffix": {
              "type": "string",
              "description": "Text after the digits, e.g. \"00\" to render full feet rather than hundreds."
            },
            "digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "MINIMUM digit count of the value in hundreds of feet, zero-padded and never truncated. 2 renders 3000 as \"30\" and still renders 12000 as \"120\"."
            }
          }
        },
        "aboveTransition": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "description": "Text before the digits, e.g. \"A\" below the transition altitude."
            },
            "suffix": {
              "type": "string",
              "description": "Text after the digits, e.g. \"00\" to render full feet rather than hundreds."
            },
            "digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "MINIMUM digit count of the value in hundreds of feet, zero-padded and never truncated. 2 renders 3000 as \"30\" and still renders 12000 as \"120\"."
            }
          }
        }
      }
    }
  }
}
