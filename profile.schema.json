{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "situation",
        "profile"
      ]
    },
    "updatedAt": {
      "type": "string"
    },
    "modals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "shown": {
            "type": "boolean"
          }
        },
        "required": [
          "x",
          "y",
          "shown"
        ],
        "additionalProperties": false
      }
    },
    "radarData": {
      "type": "object",
      "properties": {
        "gndFilterStatus": {
          "type": "boolean",
          "default": true
        },
        "primFilterStatus": {
          "type": "boolean",
          "default": true
        },
        "vfrFilterStatus": {
          "type": "boolean",
          "default": true
        },
        "upperFilterValue": {
          "type": "number"
        },
        "lowerFilterValue": {
          "type": "number"
        },
        "speedVector": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number"
            },
            "type": {
              "type": "string",
              "enum": [
                "NM",
                "MIN"
              ]
            }
          },
          "required": [
            "value",
            "type"
          ],
          "additionalProperties": false
        },
        "transitionAltitude": {
          "type": "number"
        },
        "disableAntiAliasing": {
          "type": "boolean",
          "description": "Hard-threshold every line at its half-width instead of ramping coverage. Covers map geometry, speed vectors, route legs, tag leaders, measurers and vector symbols; text, point symbols and tag corners keep their own anti-aliasing."
        },
        "hiddenTagGroups": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "labels.json toggleGroup names this view has blanked through the tagTogglesMenu click action, the vSMR fork's ASR tag toggles. Absent or empty shows every item."
        },
        "safetyNetsOff": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Safety nets the controller switched off, by policy.json kind name (stca, clam, ...). Written by the client when the controller toggles a net in a net list; honoured only for a kind the active system's safetyNets.kinds.(kind).controllerMay grants off. Absent or empty switches nothing off."
        },
        "safetyNetsSoundOff": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Safety nets whose sound the controller switched off, by policy.json kind name. Honoured only for a kind the active system grants sound. Absent or empty silences nothing."
        }
      },
      "additionalProperties": false
    },
    "atmSystem": {
      "type": "string"
    },
    "map": {
      "type": "object",
      "properties": {
        "center": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "zoom": {
          "type": "number"
        },
        "orientation": {
          "type": "number"
        },
        "windowArea": {
          "type": "object",
          "properties": {
            "minX": {
              "type": "number"
            },
            "minY": {
              "type": "number"
            },
            "maxX": {
              "type": "number"
            },
            "maxY": {
              "type": "number"
            }
          },
          "required": [
            "minX",
            "minY",
            "maxX",
            "maxY"
          ],
          "additionalProperties": false
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "showLabel": {
                "type": "boolean"
              },
              "uuid": {
                "type": "string"
              },
              "show": {
                "type": "string",
                "enum": [
                  "off"
                ],
                "description": "off forces the item off. A row without it forces the item on, so an automatic item (one whose layer gives it a showWhen) no row lists follows its showWhen, Map Edit's Auto. Map Edit writes and removes it."
              }
            },
            "required": [
              "showLabel",
              "uuid"
            ],
            "additionalProperties": false
          }
        },
        "hideTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "A map layer drawing carrying ANY of these tags is not drawn, whatever item it belongs to. Wins over showTags where both name a tag. TopSky's HideMapData; Map Edit sets it."
        },
        "showTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "When present, a TAGGED map layer drawing is drawn only if it carries at least one of these; an untagged drawing is unaffected. TopSky's ShowMapData; Map Edit sets it."
        },
        "sweepIntervalSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Seconds between aircraft repaints on this view, simulating a tracker's system-track update cycle (roughly 4 for approach, 6 for area). Each repaint draws every track at the last report it received by that cycle's instant; a position is never estimated. Omitted, 0, or anything below 0.5 leaves the view uncapped, repainting on every position batch. Values above 60 are clamped. Each radar view reads its own profile, so a main window and an inset can run different rates."
        },
        "sweepJitterSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Seconds over which each aircraft's repaint is staggered within the cycle. 0, the default, repaints every aircraft on the same tick, as a tracker-fed display moves the whole picture on one cycle; setting it to the interval spreads them evenly across the whole cycle. Clamped to the interval. Repaints quantise to the 0.5s position batch, so a window below that collapses to no stagger at all."
        }
      },
      "required": [
        "center",
        "zoom",
        "items"
      ],
      "additionalProperties": false
    },
    "filePath": {
      "type": "string"
    },
    "lastModified": {
      "type": "number"
    },
    "folderTree": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedLoginProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cursors": {
      "type": "object",
      "properties": {
        "global": {
          "type": "string"
        },
        "map": {
          "type": "string"
        },
        "qdmTool": {
          "type": "string"
        },
        "distanceTool": {
          "type": "string"
        },
        "headingTool": {
          "type": "string"
        },
        "routeDraw": {
          "type": "string"
        },
        "vectorDraw": {
          "type": "string"
        },
        "rangeRings": {
          "type": "string"
        },
        "directTo": {
          "type": "string"
        },
        "pointAndClick": {
          "type": "string"
        },
        "pointer": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string",
      "enum": [
        "local",
        "package"
      ]
    },
    "_saveMetadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "operationId": {
          "type": "string"
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "type",
    "map"
  ],
  "additionalProperties": false,
  "description": "A profile containing a view state displaying radar map items",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
